{
  "name": "quoriva-mcp",
  "version": "1.0.0",
  "description": "MCP server for academic paper search across Semantic Scholar, PubMed, and arXiv",
  "main": "build/index.js",
  "bin": {
    "quoriva-mcp": "./build/index.js"
  },
  "type": "module",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "prepublishOnly": "npm run build && cp README.md README_BACKUP.md && cp docs/README_NPM.md README.md",
    "postpublish": "mv README_BACKUP.md README.md"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "academic",
    "research",
    "papers",
    "semantic-scholar",
    "pubmed",
    "arxiv",
    "ai",
    "llm"
  ],
  "author": "hereisSwapnil",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}

